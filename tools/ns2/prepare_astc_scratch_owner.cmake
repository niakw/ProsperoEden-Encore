# N54: adapt the two actual maintained headers at configure time, no vendor fork.
foreach(variable IN ITEMS SCRATCH_INPUT TEXTURE_INPUT OUTPUT_DIR)
    if(NOT DEFINED ${variable})
        message(FATAL_ERROR "N54: missing ${variable}")
    endif()
endforeach()
foreach(path IN ITEMS "${SCRATCH_INPUT}" "${TEXTURE_INPUT}")
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "N54: missing prepared source owner ${path}")
    endif()
endforeach()
function(replace_unique var needle replacement)
    string(FIND "${${var}}" "${needle}" first)
    if(first LESS 0)
        message(FATAL_ERROR "N54 owner drift: missing unique anchor ${needle}")
    endif()
    string(LENGTH "${needle}" needle_length)
    math(EXPR next "${first} + ${needle_length}")
    string(SUBSTRING "${${var}}" ${next} -1 tail)
    string(FIND "${tail}" "${needle}" duplicate)
    if(NOT duplicate LESS 0)
        message(FATAL_ERROR "N54 owner drift: duplicate anchor ${needle}")
    endif()
    string(REPLACE "${needle}" "${replacement}" changed "${${var}}")
    set(${var} "${changed}" PARENT_SCOPE)
endfunction()
file(READ "${SCRATCH_INPUT}" scratch)
file(READ "${TEXTURE_INPUT}" texture)
set(swap_anchor "    void swap(ScratchBuffer& other) noexcept {")
set(release_code "    // N54: discard an oversized transient scratch allocation between frames.\n    void release() noexcept {\n        buffer.reset();\n        buffer_capacity = 0;\n        last_requested_size = 0;\n    }\n\n")
replace_unique(scratch "${swap_anchor}" "${release_code}${swap_anchor}")
set(copy_anchor "            std::memcpy(new_buffer.get(), buffer.get(), buffer_capacity * sizeof(T));")
set(copy_replacement "            if (buffer_capacity != 0) {\n                std::memcpy(new_buffer.get(), buffer.get(), buffer_capacity * sizeof(T));\n            }")
replace_unique(scratch "${copy_anchor}" "${copy_replacement}")
set(frame_anchor "void TextureCache<P>::TickFrame() {")
set(frame_insertion "void TextureCache<P>::TickFrame() {\n    // N54: transient ASTC/unswizzle scratch must not remain resident after\n    // a huge layered image. CPU scratch is no longer in use at frame start.\n    static constexpr size_t N54ScratchTrimThreshold = size_t{64} << 20;\n    for (auto* const scratch : {&swizzle_data_buffer, &unswizzle_data_buffer}) {\n        if (scratch->capacity() > N54ScratchTrimThreshold) {\n            scratch->release();\n        }\n    }")
replace_unique(texture "${frame_anchor}" "${frame_insertion}")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/common" "${OUTPUT_DIR}/video_core/texture_cache")
file(WRITE "${OUTPUT_DIR}/common/scratch_buffer.h" "${scratch}")
file(WRITE "${OUTPUT_DIR}/video_core/texture_cache/texture_cache.h" "${texture}")
message(STATUS "N54 research scratch owners generated from prepared Eden headers")
