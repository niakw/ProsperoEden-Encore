msgid "A4K Détails améliorés : réseau de traitement de l'image privilégiant la définition des contours. Un seul moteur NR peut être sélectionné."
msgstr "A4K Detalii îmbunătățite: procesare care prioritizează contururile clare. Se poate selecta un singur motor NR."

#: pe/ui/settings.cpp
msgid "A4K Image adoucie : réseau de traitement de l'image privilégiant la douceur du rendu et la stabilité des contours."
msgstr "A4K Imagine fină: procesare care prioritizează imaginea fină și contururile stabile."

#: pe/ui/settings.cpp
msgid "A4K Image nettoyée : réseau de traitement visant les parasites visuels et le bruit de l'image."
msgstr "A4K Imagine curățată: procesare care reduce zgomotul și artefactele vizuale."

#: pe/ui/settings.cpp
msgid "DLSS-NR Original : réseau neuronal complet. Son intensité est configurable par jeu. Le rendu PS5 complet reste à valider."
msgstr "DLSS-NR Original: rețea neuronală completă. Intensitate configurabilă pe joc. Redarea completă pe PS5 trebuie încă validată."

#: pe/ui/settings.cpp
msgid "DLSS-NR Compact : réseau neuronal réduit. Son intensité est configurable par jeu. Le rendu PS5 complet reste à valider."
msgstr "DLSS-NR Compact: rețea neuronală redusă. Intensitate configurabilă pe joc. Redarea completă pe PS5 trebuie încă validată."

#: pe/ui/settings.cpp
msgid "Neural Rendering est désactivé par défaut. Choisis directement l'un des trois A4K ou l'un des deux DLSS-NR."
msgstr "Neural Rendering este dezactivat implicit. Alege direct unul dintre cele trei moduri A4K sau cele două DLSS-NR."

#: pe/ui/settings.cpp
msgid "L'intensité est propre au DLSS-NR Original/Compact ; elle est inactive en mode A4K ou Désactivé. Le réglage enregistré est conservé."
msgstr "Intensitatea se aplică doar DLSS-NR Original/Compact. E inactivă în A4K sau Dezactivat; valoarea salvată rămâne."

#: pe/ui/settings.cpp
msgid "Intensité du DLSS-NR de 0 à 100 %. Ce réglage ne modifie ni la netteté FSR, ni l'anticrénelage, ni le Frame Generation."
msgstr "Intensitate DLSS-NR între 0 și 100%. Nu modifică claritatea FSR, antialiasingul sau Frame Generation."

#: pe/ui/settings.cpp
msgid "Ce Neural Rendering nécessite Vulkan ; OpenGL n'est pas compatible."
msgstr "Acest Neural Rendering necesită Vulkan; OpenGL nu este compatibil."

#: pe/ui/settings.cpp
msgid "Pour ce Neural Rendering, choisis Bilinéaire dans Upscaling : les compositions avec les autres méthodes ne sont pas encore validées sur PS5."
msgstr "Pentru acest Neural Rendering, alege Bilinear în Upscaling: combinațiile cu alte metode nu sunt încă validate pe PS5."

#: pe/ui/settings.cpp
msgid "Le MSAA forcé n'est pas encore validé avec Neural Rendering. Utilise Aucun, FXAA ou SMAA."
msgstr "MSAA forțat nu este încă validat cu Neural Rendering. Folosește Fără, FXAA sau SMAA."

#: pe/ui/settings.cpp
msgid "Neural Rendering et Frame Generation ne sont pas encore validés ensemble. Désactive Frame Generation."
msgstr "Neural Rendering și Frame Generation nu au fost validate împreună. Dezactivează Frame Generation."

#: pe/ui/settings.cpp
msgid "Ce moteur n'est pas encore raccordé au rendu complet du jeu."
msgstr "Acest motor nu este încă conectat la redarea completă a jocului."

