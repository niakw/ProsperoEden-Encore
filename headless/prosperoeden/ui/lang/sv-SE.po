msgid "Preset: Default ({0})"
msgstr "Förinställning: Standard ({0})"

#: pe/ui/settings.cpp
msgid "Preset: {0}"
msgstr "Förinställning: {0}"

#: pe/ui/settings.cpp
msgid "Frame Generation"
msgstr "Bildgenerering"

#: pe/ui/settings.cpp
msgid "Neural Rendering"
msgstr "Neural rendering"

