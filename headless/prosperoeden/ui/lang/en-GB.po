#: R10 graphics UX
msgid "AMD FSR 1: EASU enlarges the picture; RCAS adds sharpness. Most useful below the TV output resolution."
msgstr "AMD FSR 1: EASU enlarges the picture; RCAS adds sharpness. Most useful below the TV output resolution."

#: R10 graphics UX
msgid "Automatic"
msgstr "Automatic"

#: R10 graphics UX
msgid "Bilinear: fast and soft. Best when the game already renders near the TV resolution."
msgstr "Bilinear: fast and soft. Best when the game already renders near the TV resolution."

#: R10 graphics UX
msgid "Choose a setting; its effect is explained below."
msgstr "Choose a setting; its effect is explained below."

#: R10 graphics UX
msgid "FXAA: lightweight edge smoothing in one pass. It can slightly soften text and fine details."
msgstr "FXAA: lightweight edge smoothing in one pass. It can slightly soften text and fine details."

#: R10 graphics UX
msgid "Game default"
msgstr "Game default"

#: R10 graphics UX
msgid "Nearest: keeps hard pixel edges, with visible stair-steps. Best for pixel art, not most 3D games."
msgstr "Nearest: keeps hard pixel edges, with visible stair-steps. Best for pixel art, not most 3D games."

#: R10 graphics UX
msgid "Off: no edge smoothing. Fastest, but diagonal lines may look jagged."
msgstr "Off: no edge smoothing. Fastest, but diagonal lines may look jagged."

#: R10 graphics UX
msgid "Only AMD FSR 1 uses this percentage. Start at 50%. Increase gently for detail; reduce if edges shimmer or show halos."
msgstr "Only AMD FSR 1 uses this percentage. Start at 50%. Increase gently for detail; reduce if edges shimmer or show halos."

#: R10 graphics UX
msgid "SMAA Ultra"
msgstr "SMAA Ultra"

#: R10 graphics UX
msgid "SMAA Ultra: high-quality multi-pass edge smoothing. Clearer contours but more GPU work than FXAA."
msgstr "SMAA Ultra: high-quality multi-pass edge smoothing. Clearer contours but more GPU work than FXAA."

#: R10 graphics UX
msgid "TEXTURE FILTERING"
msgstr "TEXTURE FILTERING"

#: R10 graphics UX
msgid "Texture filtering"
msgstr "Texture filtering"

#: R10 graphics UX
msgid "Texture filtering keeps distant ground and surfaces clearer at an angle; higher anisotropy uses more GPU bandwidth."
msgstr "Texture filtering keeps distant ground and surfaces clearer at an angle; higher anisotropy uses more GPU bandwidth."

#: R10 graphics UX
msgid "UPSCALING"
msgstr "UPSCALING"

#: R10 graphics UX
msgid "Upscaling"
msgstr "Upscaling"

#: R10 video menu
msgid "FSR 1"
msgstr "FSR 1"

#: R10 video menu
msgid "Frame generation needs Vulkan. Select Vulkan to enable this option."
msgstr "Frame generation needs Vulkan. Select Vulkan to enable this option."

#: R10 video menu
msgid "This option needs Vulkan. OpenGL cannot generate extra frames; changing it would have no effect."
msgstr "This option needs Vulkan. OpenGL cannot generate extra frames; changing it would have no effect."
#: R24 FXAA Quality
msgid "FXAA+"
msgstr "FXAA+"

#: R24 FXAA Quality
msgid "FXAA+ requires Vulkan. Choose Vulkan or another anti-aliasing method."
msgstr "FXAA+ requires Vulkan. Choose Vulkan or another anti-aliasing method."

#: R24 FXAA Quality
msgid "FXAA+: extended edge search. Can smooth more jagged edges but may soften textures. Compare with SMAA Ultra."
msgstr "FXAA+: extended edge search. Can smooth more jagged edges but may soften textures. Compare with SMAA Ultra."

#: R10 graphics UX
msgid "Inactive: this upscale method does not support the sharpness slider. Use FSR 1 or SGSR with Vulkan."
msgstr "Inactive: this upscale method does not support the sharpness slider. Use FSR 1 or SGSR with Vulkan."

#: R10 graphics UX
msgid "Lanczos"
msgstr "Lanczos"

#: R10 graphics UX
msgid "Lanczos: sharp reconstruction of a scaled image. Fine detail may look clearer, but edges can form bright halos."
msgstr "Lanczos: sharp reconstruction of a scaled image. Fine detail may look clearer, but edges can form bright halos."

#: R10 graphics UX
msgid "SGSR"
msgstr "SGSR"

#: R10 graphics UX
msgid "SGSR Edge"
msgstr "SGSR Edge"

#: R10 graphics UX
msgid "SGSR Edge: edge-directed Qualcomm upscale with a different Vulkan shader. Compare fine detail and halos."
msgstr "SGSR Edge: edge-directed Qualcomm upscale with a different Vulkan shader. Compare fine detail and halos."

#: R10 graphics UX
msgid "SGSR edge sharpness: 0% disables extra edge intensity, 50% is balanced, 100% is strongest. Reduce halos if needed."
msgstr "SGSR edge sharpness: 0% disables extra edge intensity, 50% is balanced, 100% is strongest. Reduce halos if needed."

#: R10 graphics UX
msgid "SGSR: Qualcomm spatial upscale using a separate Vulkan shader. Try it when FSR 1 looks soft."
msgstr "SGSR: Qualcomm spatial upscale using a separate Vulkan shader. Try it when FSR 1 looks soft."

#: R10 graphics UX
msgid "Sharpness"
msgstr "Sharpness"

#: R07 SGSR graphics
msgid "Bicubic: sharper than bilinear, but may create bright edges. The sharpness slider does not apply."
msgstr "Bicubic: sharper than bilinear, but may create bright edges. The sharpness slider does not apply."

#: R07 SGSR graphics
msgid "Image sharpness affects FSR 1 and SGSR only. Start at 50% and reduce it if fine edges shimmer or show halos."
msgstr "Image sharpness affects FSR 1 and SGSR only. Start at 50% and reduce it if fine edges shimmer or show halos."

#: R07 SGSR graphics
msgid "SHARPNESS"
msgstr "SHARPNESS"

#: R07 SGSR graphics
msgid "Texture filtering sharpens roads, floors and walls viewed at an angle. Start at 4x; 8x/16x use more GPU bandwidth. Unlike image sharpness, it does not sharpen the whole picture."
msgstr "Texture filtering sharpens roads, floors and walls viewed at an angle. Start at 4x; 8x/16x use more GPU bandwidth. Unlike image sharpness, it does not sharpen the whole picture."

#: pe/ui/settings.cpp
msgid "Turn OFF Neural Rendering first. NR and frame generation are not validated together on PS5."
msgstr "Turn OFF Neural Rendering first. NR and frame generation are not validated together on PS5."

