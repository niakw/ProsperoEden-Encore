#version 450
// SPDX-License-Identifier: GPL-3.0-or-later
// STRICTLY A HOST TEST FIXTURE. This is not DLSS, neural inference,
// a trained model, or a runtime optimization. Supplies a known RGB delta
// to prove the pack -> residual transfer path does not merely pass through.
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=0) uniform sampler2D beforeModel;
layout(set=0,binding=1,rgba16f) writeonly uniform image2D syntheticAfter;
layout(push_constant) uniform Dimensions {
    uvec2 originalExtent;
    uvec2 workExtent;
    vec2 centerFraction;
    vec2 workFraction;
} dims;
void main(){
    uvec2 id=gl_GlobalInvocationID.xy;
    if(any(greaterThanEqual(id,dims.workExtent)))return;
    vec4 color=texelFetch(beforeModel,ivec2(id),0);
    // Deliberately vary across both work-space axes. A constant delta
    // would not prove that the inverse peripheral mapping is correct.
    vec2 uv=(vec2(id)+vec2(0.5))/vec2(dims.workExtent);
    color.rgb += vec3(0.125*uv.x,-0.0625*uv.y,0.125*(uv.x+uv.y));
    imageStore(syntheticAfter,ivec2(id),color);
}
