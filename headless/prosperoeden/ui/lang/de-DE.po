msgstr "Voreinstellung: {0}"

#: pe/ui/settings.cpp
msgid "Frame Generation"
msgstr "Frame-Generierung"

#: pe/ui/settings.cpp
msgid "Neural Rendering"
msgstr "Neuronales Rendering"

