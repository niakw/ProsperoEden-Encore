#: pe/ui/settings.cpp
msgid "A4K Image nettoyée : réseau de traitement visant les parasites visuels et le bruit de l'image."
msgstr "A4K Gambar dibersihkan: pemrosesan untuk mengurangi noise dan artefak visual."

#: pe/ui/settings.cpp
msgid "DLSS-NR Original : réseau neuronal complet. Son intensité est configurable par jeu. Le rendu PS5 complet reste à valider."
msgstr "DLSS-NR Original: jaringan neural lengkap. Intensitas dapat diatur per game. Rendering penuh di PS5 masih perlu divalidasi."

#: pe/ui/settings.cpp
msgid "DLSS-NR Compact : réseau neuronal réduit. Son intensité est configurable par jeu. Le rendu PS5 complet reste à valider."
msgstr "DLSS-NR Compact: jaringan neural lebih kecil. Intensitas dapat diatur per game. Rendering penuh di PS5 masih perlu divalidasi."

#: pe/ui/settings.cpp
msgid "Neural Rendering est désactivé par défaut. Choisis directement l'un des trois A4K ou l'un des deux DLSS-NR."
msgstr "Neural Rendering dinonaktifkan secara default. Pilih salah satu dari tiga mode A4K atau dua mode DLSS-NR."

#: pe/ui/settings.cpp
msgid "L'intensité est propre au DLSS-NR Original/Compact ; elle est inactive en mode A4K ou Désactivé. Le réglage enregistré est conservé."
msgstr "Intensitas hanya berlaku untuk DLSS-NR Original/Compact. Tidak aktif saat A4K atau Mati; nilai tersimpan tetap ada."

#: pe/ui/settings.cpp
msgid "Intensité du DLSS-NR de 0 à 100 %. Ce réglage ne modifie ni la netteté FSR, ni l'anticrénelage, ni le Frame Generation."
msgstr "Intensitas DLSS-NR 0–100%. Tidak mengubah ketajaman FSR, antialiasing, atau Frame Generation."

#: pe/ui/settings.cpp
msgid "Ce Neural Rendering nécessite Vulkan ; OpenGL n'est pas compatible."
msgstr "Neural Rendering ini memerlukan Vulkan; OpenGL tidak didukung."

#: pe/ui/settings.cpp
msgid "Pour ce Neural Rendering, choisis Bilinéaire dans Upscaling : les compositions avec les autres méthodes ne sont pas encore validées sur PS5."
msgstr "Untuk Neural Rendering ini pilih Bilinear di Upscaling: kombinasi dengan metode lain belum divalidasi di PS5."

#: pe/ui/settings.cpp
msgid "Le MSAA forcé n'est pas encore validé avec Neural Rendering. Utilise Aucun, FXAA ou SMAA."
msgstr "MSAA yang dipaksakan belum divalidasi dengan Neural Rendering. Gunakan Tidak ada, FXAA, atau SMAA."

#: pe/ui/settings.cpp
msgid "Neural Rendering et Frame Generation ne sont pas encore validés ensemble. Désactive Frame Generation."
msgstr "Neural Rendering dan Frame Generation belum divalidasi bersamaan. Matikan Frame Generation."

#: pe/ui/settings.cpp
msgid "Ce moteur n'est pas encore raccordé au rendu complet du jeu."
msgstr "Mesin ini belum terhubung dengan rendering penuh game."

